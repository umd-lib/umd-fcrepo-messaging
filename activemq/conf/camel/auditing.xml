<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
  http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">
  
  <bean id="auditDatabase" class="org.postgresql.ds.PGSimpleDataSource">
    <property name="serverName" value="${AUDIT_DB_HOST}"/>
    <property name="portNumber" value="${AUDIT_DB_PORT}"/>
    <property name="databaseName" value="${AUDIT_DB_NAME}"/>
    <property name="user" value="${AUDIT_DB_USERNAME}"/>
    <property name="password" value="${AUDIT_DB_PASSWORD}"/>
  </bean>

  <routeContext xmlns="http://camel.apache.org/schema/spring" id="Auditing">
    <!--
    Expected headers:
    * FcrepoUri
    * FcrepoEventId
    * FcrepoEventName
    Expected environment variables:
    * AUDIT_EVENT_BASE_URI
    -->
    <route id="edu.umd.lib.camel.routes.queue.audit">
      <from uri="activemq:audit"/>
      <log loggingLevel="DEBUG" message="Receiving audit event for ${header.FcrepoUri}"/>
      <setHeader name="AuditEventUri">
        <simple>${sysenv.AUDIT_EVENT_BASE_URI}${header.FcrepoEventId}</simple>
      </setHeader>
      <choice>
        <when>
          <simple>${headers.FcrepoEventName} == "create binary"</simple>
          <setHeader name="AuditEventType">
            <constant>http://id.loc.gov/vocabulary/preservation/eventType/ing</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "create RDF"</simple>
          <setHeader name="AuditEventType">
            <constant>http://id.loc.gov/vocabulary/preservation/eventType/cre</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "import binary"</simple>
          <setHeader name="AuditEventType">
            <constant>http://id.loc.gov/vocabulary/preservation/eventType/ing</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "import RDF"</simple>
          <setHeader name="AuditEventType">
            <constant>http://id.loc.gov/vocabulary/preservation/eventType/cre</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "update binary"</simple>
          <setHeader name="AuditEventType">
            <constant>http://fedora.info/definitions/v4/audit#contentModification</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "update RDF"</simple>
          <setHeader name="AuditEventType">
            <constant>http://fedora.info/definitions/v4/audit#metadataModification</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "delete binary"</simple>
          <setHeader name="AuditEventType">
            <constant>http://fedora.info/definitions/v4/audit#contentRemoval</constant>
          </setHeader>
        </when>
        <when>
          <simple>${headers.FcrepoEventName} == "delete RDF"</simple>
          <setHeader name="AuditEventType">
            <constant>http://id.loc.gov/vocabulary/preservation/eventType/del</constant>
          </setHeader>
        </when>
      </choice>
      <log loggingLevel="DEBUG" message="Event type for PREMIS: ${header.AuditEventType}"/>
      <multicast parallelProcessing="true">
        <to uri="direct:auditing.GeneratePremis"/>
        <to uri="activemq:audit.database"/>
      </multicast>
    </route>

    <!--
    Expected headers:
    * AuditEventUri
    * FcrepoDateTime
    * FcrepoUser
    * FcrepoUserAgent
    * AuditEventType
    -->
    <route id="edu.umd.lib.camel.routes.auditing.GeneratePremis">
      <from uri="direct:auditing.GeneratePremis"/>
      <setBody>
        <simple><![CDATA[
<${header.AuditEventUri}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://fedora.info/definitions/v4/audit#InternalEvent> .
<${header.AuditEventUri}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.loc.gov/premis/rdf/v1#Event> .
<${header.AuditEventUri}> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/prov#InstantaneousEvent> .

<${header.AuditEventUri}> <http://www.loc.gov/premis/rdf/v1#hasEventDateTime> "${header.FcrepoDateTime}"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
<${header.AuditEventUri}> <http://www.loc.gov/premis/rdf/v1#hasEventRelatedObject> <${header.FcrepoUri}> .
<${header.AuditEventUri}> <http://www.loc.gov/premis/rdf/v1#hasEventRelatedAgent> "${header.FcrepoUser}"^^<http://www.w3.org/2001/XMLSchema#string>.
<${header.AuditEventUri}> <http://www.loc.gov/premis/rdf/v1#hasEventRelatedAgent> "${header.FcrepoUserAgent}"^^<http://www.w3.org/2001/XMLSchema#string> .
<${header.AuditEventUri}> <http://www.loc.gov/premis/rdf/v1#hasEventType> <${header.AuditEventType}> .
        ]]></simple>
      </setBody>
      <to uri="activemq:queue:audit.triplestore"/>
    </route>

    <!--
    Expected headers:
    * AuditEventUri
    * AuditEventType
    * FcrepoUser
    * FcrepoUri
    * FcrepoDateTime
    Expected body format:
    * (None)
    Expected beans:
    * auditDatabase : javax.sql.DataSource
    -->
    <route id="edu.umd.lib.camel.routes.queue.audit.database">
      <from uri="activemq:audit.database"/>
      <setBody>
        <constant><![CDATA[
          INSERT INTO history (event_uri, event_type, username, resource_uri, timestamp)
          VALUES (:?AuditEventUri, :?AuditEventType, :?FcrepoUser, :?FcrepoUri, (:?FcrepoDateTime)::timestamp with time zone)
          ]]></constant>
      </setBody>
      <to uri="jdbc:auditDatabase?useHeadersAsParameters=true"/>
    </route>

    <!--
    Expected headers:
    * (None)
    Expected body format:
    * application/n-triples
    Expected environment variables:
    * AUDIT_TRIPLESTORE_UPDATE_URI
    -->
    <route id="edu.umd.lib.camel.routes.queue.audit.triplestore">
      <from uri="activemq:audit.triplestore"/>
      <removeHeaders pattern="*"/>
      <setHeader name="Content-Type">
        <constant>application/sparql-update</constant>
      </setHeader>
      <setHeader name="CamelHttpMethod">
        <constant>POST</constant>
      </setHeader>
      <setHeader name="CamelHttpUri">
        <simple>${sysenv.AUDIT_TRIPLESTORE_UPDATE_URI}</simple>
      </setHeader>
      <setBody>
        <simple>INSERT DATA { ${body} }</simple>
      </setBody>
      <to uri="http:triplestore"/>
    </route>

  </routeContext>

</beans>
