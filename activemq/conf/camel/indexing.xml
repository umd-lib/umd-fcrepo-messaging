<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
  http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

  <routeContext xmlns="http://camel.apache.org/schema/spring" id="Indexing">
    <route id="edu.umd.lib.camel.routes.queue.index">
      <from uri="activemq:index"/>
      <choice>
        <when>
          <header>FcrepoIndexingDestinations</header>
          <log loggingLevel="DEBUG" message="FcrepoIndexingDestinations header found: ${header.FcrepoIndexingDestinations}"/>
        </when>
        <otherwise>
          <log loggingLevel="DEBUG" message="No FcrepoIndexingDestinations header found, using default"/>
          <setHeader name="FcrepoIndexingDestinations">
            <constant>activemq:index.triplestore,activemq:index.solr</constant>
          </setHeader>
        </otherwise>
      </choice>
      <log loggingLevel="INFO" message="Indexing destinations: ${header.FcrepoIndexingDestinations}"/>
      <recipientList ignoreInvalidEndpoints="true" parallelProcessing="true">
        <header>FcrepoIndexingDestinations</header>
      </recipientList>
    </route>

    <route id="edu.umd.lib.camel.routes.queue.reindex">
      <from uri="activemq:reindex"/>
      <log loggingLevel="INFO" message="Reindexing resource ${header.FcrepoUri}"/>
      <!-- a request to reindex should be treated the same as if the resource was updated -->
      <setHeader name="FcrepoEventName">
        <constant>update</constant>
      </setHeader>
      <to uri="activemq:index"/>
    </route>
  </routeContext>
</beans>